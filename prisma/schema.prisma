generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum OperationType {
  NACIONAL
  INTRA_SERVICIOS
}

enum InvoiceStatus {
  PENDIENTE
  COBRADA
}

enum ExpenseSource {
  MANUAL
  OCR
}

// taxId: NIF for Spanish contacts, NIF-IVA (country prefix) for EU contacts.
model Client {
  id          String    @id @default(uuid()) @db.Uuid
  name        String
  taxId       String    @unique
  countryCode String    @default("ES") @db.Char(2)
  email       String?
  address     String?
  createdAt   DateTime  @default(now())
  invoices    Invoice[]
}

model Supplier {
  id          String    @id @default(uuid()) @db.Uuid
  name        String
  taxId       String    @unique
  countryCode String    @default("ES") @db.Char(2)
  createdAt   DateTime  @default(now())
  expenses    Expense[]
}

// Amounts are integer cents; totals are computed by lib/fiscal and stored for summaries.
model Invoice {
  id            String        @id @default(uuid()) @db.Uuid
  number        String        @unique
  issueDate     DateTime      @db.Date
  operationType OperationType @default(NACIONAL)
  clientId      String        @db.Uuid
  client        Client        @relation(fields: [clientId], references: [id], onDelete: Restrict)
  baseCents     Int
  vatCents      Int
  totalCents    Int
  status        InvoiceStatus @default(PENDIENTE)
  paidAt        DateTime?
  notes         String?
  createdAt     DateTime      @default(now())
  lines         InvoiceLine[]

  @@index([clientId])
  @@index([issueDate])
}

model InvoiceLine {
  id             String  @id @default(uuid()) @db.Uuid
  invoiceId      String  @db.Uuid
  invoice        Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  description    String
  quantity       Int     @default(1)
  unitPriceCents Int
  vatRate        Int // 21, 10, 4 or 0
  baseCents      Int
  vatCents       Int

  @@index([invoiceId])
}

model Expense {
  id          String        @id @default(uuid()) @db.Uuid
  number      String?
  date        DateTime      @db.Date
  description String
  supplierId  String        @db.Uuid
  supplier    Supplier      @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  baseCents   Int
  vatRate     Int
  vatCents    Int
  irpfRate    Int           @default(0)
  irpfCents   Int           @default(0)
  totalCents  Int // base + IVA - IRPF
  deductible  Boolean       @default(true)
  source      ExpenseSource @default(MANUAL)
  createdAt   DateTime      @default(now())

  @@index([supplierId])
  @@index([date])
}
