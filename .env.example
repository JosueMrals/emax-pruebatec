# Supabase → Connect → ORMs → Prisma. Codifica en la URL los caracteres especiales de la contraseña (@ → %40).
DATABASE_URL="postgresql://postgres.<proyecto>:<contraseña>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.<proyecto>:<contraseña>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# OCR de gastos (Google AI Studio → Get API key). Solo se lee en app/api/ocr/route.ts.
GEMINI_API_KEY=""

# Cliente de Supabase (página de ejemplo /todos).
NEXT_PUBLIC_SUPABASE_URL="https://<proyecto>.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=""
